# Copy to .env.local.local (gitignored) and restart `npx expo start`.
# Base URL of the PHP backend (docker compose serves it on port 80):
#   Android emulator  -> http://10.0.2.2
#   iOS simulator     -> http://localhost
#   Physical device   -> http://<your computer's LAN IP>
EXPO_PUBLIC_API_URL=http://10.0.2.2
